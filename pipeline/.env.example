# Supabase > Project Settings > Database > Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT=Vertical Frame research alec@verticalframe.ai

ANTHROPIC_API_KEY=
DOC_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
MAX_DOCS_PER_RUN=200

TARGET_STATES=AZ

# Optional: JSON name-search URL from recorder.maricopa.gov (see BUILD_GUIDE step 5).
# Do not use https://publicapi.recorder.maricopa.gov/documents/search — it ignores the name.
MARICOPA_RECORDER_SEARCH_URL=
# Optional: override if Pima's park land-use codes differ (see `mhdebt probe pima`)
# PIMA_PARK_WHERE=PARCEL_USE >= '0840' AND PARCEL_USE <= '0899'

DATA_DIR=./data
CACHE_DIR=./.cache
